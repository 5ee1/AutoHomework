{
  "manifest_version": 3,
  "name": "AutoHomework",
  "version": "1.3.2",
  "description": "Analyze and fill supported Chaoxing homework, chapter quiz, and task-point pages.",
  "permissions": ["tabs", "scripting", "webNavigation"],
  "host_permissions": [
    "*://*.chaoxing.com/*",
    "http://127.0.0.1:3210/*"
  ],
  "action": {
    "default_title": "AutoHomework",
    "default_popup": "popup.html"
  }
}
