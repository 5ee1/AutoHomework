{
  "manifest_version": 3,
  "name": "AutoHomework",
  "version": "1.1.0",
  "description": "Analyze and fill supported Chaoxing homework pages with a local AI service.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "*://*.chaoxing.com/*",
    "http://127.0.0.1:3210/*"
  ],
  "action": {
    "default_title": "AutoHomework",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.chaoxing.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
